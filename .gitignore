# Xcode and Swift
#
# Files that are generated, machine specific, or private. Project configuration
# is deliberately not ignored: project.pbxproj, contents.xcworkspacedata, shared
# schemes under xcshareddata, and the asset catalog all belong in version
# control so a fresh clone builds and CI resolves the scheme.

## macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

## Xcode user state
#
# Per-user window layout, breakpoints, and scheme ordering. Shared schemes live
# in xcshareddata and stay tracked.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

## Build output
build/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.moved-aside

## Legacy Xcode project cruft
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## Swift Package Manager
#
# Package.resolved is intentionally NOT ignored. It pins dependency versions and
# is required for reproducible builds if packages are ever added.
.build/
.swiftpm/

## CocoaPods and Carthage
#
# Neither is used. These rules only guard against accidental check-in.
Pods/
Carthage/Build/

## Signing material and secrets
#
# Certificates, provisioning profiles, and local configuration must never be
# committed. Shared .xcconfig files are allowed; only local overrides are ignored.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*
Secrets.swift
*.local.xcconfig
Local.xcconfig

## Editors
.vscode/
.idea/
*.swp
*~

## fastlane
#
# Not used, kept as a guard.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local project notes
#
# CONTEXT.md is kept in the working copy only, not in version control.
CONTEXT.md

# Generated documentation
site/
